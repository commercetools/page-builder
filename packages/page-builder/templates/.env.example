# Page-builder environment — copy these vars into your main .env / .env.local. One CT client
# covers both the storefront runtime and the `page-builder` CLI (sync/publish/pull); there is
# no separate deploy-only env file.
# Scaffolded by `@commercetools-labs/page-builder init`.

# ── CT client (storefront runtime AND the `page-builder` CLI) ────────────────────────────
# The CLI's write step (sync/publish/pull) needs `manage_key_value_documents` on top of
# whatever scope the storefront runtime already needs from this client — grant both on the
# same client in Merchant Center rather than provisioning a second one. If you'd rather keep
# them separate (e.g. a stricter prod deploy pipeline), point `--env <path>` at a different
# file when running the CLI; the vars below are what it needs either way.
CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_AUTH_URL=https://auth.<region>.commercetools.com
CTP_API_URL=https://api.<region>.commercetools.com
# Optional; the CLI defaults to manage_key_value_documents:${CTP_PROJECT_KEY} when unset. Set
# this explicitly if your storefront runtime already sets CTP_SCOPES to something narrower —
# the CLI's token request needs manage_key_value_documents included.
# CTP_SCOPES=

# ── Storefront preview / visual editing ──────────────────────────────────────────────────
# Read draft (vs published) page content when ?pb_preview matches this token.
PB_PREVIEW_TOKEN=
# Serve page content from CT rather than hardcoded fallbacks.
DYNAMIC_PAGES=true
# Comma-separated Merchant Center origins allowed to embed + drive the bridge. Read
# SERVER-SIDE by getPageBuilderConfig() and passed to <BridgeMount/> as a prop (no
# NEXT_PUBLIC_ prefix — the allowlist should not ship to the client). Must match the MC app's
# ACTUAL runtime origin exactly, including scheme (http vs https) — a mismatch here makes the
# bridge silently inert (connects to nothing, so hover/click do nothing in preview).
PB_ALLOWED_ORIGINS=https://mc.<region>.commercetools.com
