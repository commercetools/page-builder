# Local development for page-builder-service against a real commercetools project:
#   cp .env.example .env     # .env is git-ignored; never commit or paste real credentials
#   npm run dev        # loads .env when it exists
# `npm run dev:fake` needs none of this: it runs against an in-memory commercetools.
#
# On Connect none of this is set by hand. The CTP_* values are injected from the API client the
# platform generates (connect.yaml `inheritAs`); the rest is the connect.yaml configuration.

# ── commercetools access (injected by Connect) ──────────────────────────────────────────
CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
# Either name the region and the URLs are derived (e.g. europe-west1.gcp, us-central1.gcp) ...
CTP_REGION=europe-west1.gcp
# ... or set them explicitly:
# CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
# CTP_API_URL=https://api.europe-west1.gcp.commercetools.com
# Scopes to request, space-separated, exactly as given. Leave unset to request none: commercetools then
# issues the token with whatever scopes your API client has (for example manage_project:<project-key>),
# so a client that is narrower or wider than the list under "Scopes" in the README just works.
# On Connect this is injected from connect.yaml (inheritAs.apiClient.scopes).
# CTP_SCOPE=

# ── Server ──────────────────────────────────────────────────────────────────────────────
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info

# ── Storefront render API (required when NODE_ENV=production) ───────────────────────────
PB_RENDER_KEY=
# Comma-separated storefront server origins allowed to call /v1/render.
PB_RENDER_ORIGINS=http://localhost:3000

# ── Merchant Center ─────────────────────────────────────────────────────────────────────
# Origins allowed to embed and drive the visual-editing bridge.
PB_EDITOR_ORIGINS=https://mc.europe-west1.gcp.commercetools.com
# Enable the admin object gateway: the MC API Gateway the JWTs come from (gcp-eu, gcp-us,
# gcp-au, aws-eu, aws-us, or a URL). Leave unset to disable.
# PB_MC_ISSUER=gcp-eu
# The service's public URL. Connect sets this when deployed; it is only set by hand for local
# development (the audience of the Merchant Center's JWT is its origin).
# CONNECT_SERVICE_URL=http://localhost:8080
# Local development with the Merchant Center app (`yarn start` in page-editor). The MC API Gateway
# runs in the cloud and cannot forward to localhost, so the app's dev server calls this service
# directly with this token instead. Needs PB_EDITOR_ORIGINS to be the dev server's origin
# (http://localhost:3001) and the same value as PAGE_BUILDER_SERVICE_DEV_TOKEN in
# page-editor/.env.local. Any non-empty value; anyone who can reach this service while it runs can use it,
# so a random one is safer on a shared network, e.g.  openssl rand -hex 16
# The service refuses to start with this set when NODE_ENV=production.
# PB_DEV_TOKEN=

# ── Media uploads (optional) ────────────────────────────────────────────────────────────
# Where the editor's image/video fields upload to: a Google Cloud Storage bucket. Leave both unset
# to switch media off (its endpoints then answer 501). Set both or neither.
#   - Use uniform bucket-level access, and grant allUsers the Storage Object Viewer role: objects are
#     read straight from https://storage.googleapis.com/<bucket>/<key>.
#   - The service account needs Storage Object Creator and Storage Object Viewer (to list).
# PB_MEDIA_BUCKET=
# One service-account JSON key, base64 on a single line:  base64 -i key.json | tr -d '\n'
# PB_MEDIA_SERVICE_ACCOUNT_KEY_B64=
# Object key prefix inside the bucket.
# PB_MEDIA_PATH_PREFIX=page-builder/media
# Largest accepted upload in bytes (1024 to 26214400); the file is held in memory while it is checked.
# PB_MEDIA_MAX_BYTES=10485760
# Comma-separated allowed content types. Supported: image/jpeg, image/png, image/gif, image/webp,
# image/avif, video/mp4, video/webm, application/pdf (SVG and HTML are deliberately not).
# PB_MEDIA_ALLOWED_TYPES=

# ── Preview and catalog ingest ──────────────────────────────────────────────────────────
# Unlocks draft/preview and edit mode; unset disables previews.
# PB_PREVIEW_TOKEN=
# Bearer secret for catalog validate / push / publish from CI (required in production).
PB_ADMIN_SECRET=

# ── Tuning ──────────────────────────────────────────────────────────────────────────────
# Seconds to cache commercetools reads; preview and draft reads are never cached; 0 disables.
PB_CACHE_TTL_SECONDS=15
# Product attribute names to offer as facets, in order; empty derives them from product types.
# PB_FACET_ATTRIBUTES=
PB_FACET_LIMIT=8
