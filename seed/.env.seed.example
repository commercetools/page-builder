# CT credentials for the seed script — copy to .env.seed and fill in your values.
# .env.seed is git-ignored; never commit real credentials.

# CT project key
CTP_PROJECT_KEY=my-project-key

# CT API client credentials (needs manage_key_value_documents scope)
CTP_CLIENT_ID=your-client-id
CTP_CLIENT_SECRET=your-client-secret

# Auth URL for your region, e.g.:
#   Europe (GCP): https://auth.europe-west1.gcp.commercetools.com
#   US (GCP):     https://auth.us-central1.gcp.commercetools.com
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com

# API URL for your region, e.g.:
#   Europe (GCP): https://api.europe-west1.gcp.commercetools.com
#   US (GCP):     https://api.us-central1.gcp.commercetools.com
CTP_API_URL=https://api.europe-west1.gcp.commercetools.com

# Optional: set to "published" to also seed the published object (default: draft only)
# SEED_TARGET=both
