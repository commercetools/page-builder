ENABLE_NEW_JSX_TRANSFORM="true"
FAST_REFRESH="true"

ENTRY_POINT_URI_PATH="page-editor"
CLOUD_IDENTIFIER=gcp-us
CUSTOM_APPLICATION_ID=123
APPLICATION_URL=https://page-editor.example.com
INITIAL_PROJECT_KEY=multiplatform-us-store

# The page-builder service (Connect) the MC app reads and writes through, including its /service path.
# Empty keeps every hook on the Merchant Center GraphQL gateway. The service must be configured with
# PB_MC_ISSUER (this project's MC API gateway) and PB_MC_AUDIENCE (its own origin).
# The same URL is where `kind: 'image'` / `kind: 'video'` fields upload to and list from: configure the
# service's PB_MEDIA_BUCKET and PB_MEDIA_SERVICE_ACCOUNT_KEY_B64 to switch uploads on (no extra app setting).
PAGE_BUILDER_SERVICE_URL=http://localhost:8080/service
# `all`, or a comma list of: pages, page-components, comments, workflows, page-workflow,
# preview-settings, data-sources, sections, components, instances, reset. Empty means none.
PAGE_BUILDER_SERVICE_HOOKS=all
