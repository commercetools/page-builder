{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": [
      // Webpack build output. Gitignored, regenerated by every `yarn build`,
      // and not code anyone can fix.
      "public/**",
      // Generated from the commercetools GraphQL schema by codegen; editing it
      // by hand would be undone on the next run.
      "src/types/generated/**"
    ]
  }
}
