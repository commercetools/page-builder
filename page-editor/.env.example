ENABLE_NEW_JSX_TRANSFORM="true"
FAST_REFRESH="true"

ENTRY_POINT_URI_PATH="page-editor"
CLOUD_IDENTIFIER=gcp-eu
CUSTOM_APPLICATION_ID=<your-custom-application-id>
APPLICATION_URL=https://<your-deployed-app-url>
INITIAL_PROJECT_KEY=<your-project-key>

# Base URL of the contentools media service, used by `kind: 'image'` fields. MUST include
# the `/service` path prefix and no trailing slash. Empty disables the picker (the field
# renders a "not configured" note). Local service: http://localhost:8080/service
IMAGE_PICKER_BASE_URL=
# Namespaces media storage on the service. Empty falls back to 'default'.
IMAGE_PICKER_BUSINESS_UNIT_KEY=default