# Local development for the Merchant Center app (`yarn start`).
#   cp .env.example .env   # .env is git-ignored
#
# CUSTOM_APPLICATION_ID is the id Merchant Center returns when you register the custom application;
# INITIAL_PROJECT_KEY is the commercetools project you develop against.

ENABLE_NEW_JSX_TRANSFORM="true"
FAST_REFRESH="true"

ENTRY_POINT_URI_PATH="page-editor-us"
CLOUD_IDENTIFIER=gcp-us
CUSTOM_APPLICATION_ID=
APPLICATION_URL=
INITIAL_PROJECT_KEY=

# Base URL of the contentools media service, used by `kind: 'image'` fields. MUST include
# the `/service` path prefix and no trailing slash. Empty disables the picker (the field
# renders a "not configured" note). Local service: http://localhost:8080/service
IMAGE_PICKER_BASE_URL=
# Namespaces media storage on the service. Empty falls back to 'default'.
IMAGE_PICKER_BUSINESS_UNIT_KEY=default

# The page-builder service (Connect) the MC app reads and writes through, including its /service path.
# Empty keeps every hook on the Merchant Center GraphQL gateway. The service must be configured with
# PB_MC_ISSUER (this project's MC API gateway); its audience is the origin of the CONNECT_DEPLOYED_URL that Connect provides.
PAGE_BUILDER_SERVICE_URL=
# `all`, or a comma list of: pages, page-components, comments, workflows, page-workflow,
# preview-settings, data-sources, sections, components, instances, reset. Empty means none.
PAGE_BUILDER_SERVICE_HOOKS=all
