# The page-builder service (commercetools Connect). Include the Connect endpoint (`/service`).
PB_SERVICE_URL=http://127.0.0.1:8080/service

# Required by the service in production; unset is fine against the local fake.
PB_RENDER_KEY=
# This storefront's public origin; sent as X-PB-Origin and checked against the service allowlist.
PB_ORIGIN=http://localhost:3000

# commercetools store key that scopes products to this storefront.
STORE_KEY=gap

# CI only (pb:validate / pb:push / pb:publish): the service's admin secret.
PB_ADMIN_SECRET=
